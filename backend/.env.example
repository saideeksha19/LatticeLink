# LatticeLink Backend Environment Variables
# Copy this file to .env in latticelink/backend/ (DO NOT commit .env to version control)

# --- Flask Server Security ---
SECRET_KEY=latticelink-quantum-dev-secret-key-change-in-prod
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# --- Database Configuration ---
DATABASE_URL=sqlite:///instance/latticelink.db

# --- Storage Directory for Encrypted Files & Media ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=209715200

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Email Delivery via Gmail SMTP ---
# 1. Enable 2-Step Verification on the sender Google account.
# 2. Generate a 16-character Gmail App Password (Google Account -> Security -> App Passwords).
# 3. Put the REAL values only in the Render Dashboard -> Environment.
#    NEVER commit real credentials to version control.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_sender_gmail@gmail.com
MAIL_PASSWORD=your_16_character_gmail_app_password
MAIL_DEFAULT_SENDER=your_sender_gmail@gmail.com

# --- Session Lifetime (seconds) ---
SESSION_EXPIRY=3600

