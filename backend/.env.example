# LatticeLink Backend Environment Variables
# Copy this file to .env in latticelink/backend/ (DO NOT commit .env to version control)

# --- Flask Server Security ---
SECRET_KEY=latticelink-quantum-dev-secret-key-change-in-prod
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# --- Database Configuration ---
DATABASE_URL=sqlite:///instance/latticelink.db

# --- Storage Directory for Encrypted Files & Media ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=209715200

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Email Delivery via Brevo Transactional API (free tier: 300 emails/day) ---
# 1. Create a free Brevo account at https://www.brevo.com (no credit card).
# 2. Verify a sender identity: Brevo Dashboard -> Senders & IP -> Senders.
# 3. Create an API key: Brevo Dashboard -> SMTP & API -> API Keys.
# 4. Put the REAL values ONLY in the Render Dashboard -> Environment.
#    NEVER commit real credentials to version control.
BREVO_API_KEY=your_brevo_api_key_here
MAIL_DEFAULT_SENDER=your_verified_sender@yourdomain.com

# --- Session Lifetime (seconds) ---
SESSION_EXPIRY=3600

