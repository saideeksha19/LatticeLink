# LatticeLink Backend Environment Variables
# Copy this file to .env in latticelink/backend/ (DO NOT commit .env to version control)

# --- Flask Server Security ---
SECRET_KEY=latticelink-quantum-dev-secret-key-change-in-prod
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# --- Database Configuration ---
DATABASE_URL=sqlite:///instance/latticelink.db

# --- Storage Directory for Encrypted Files & Media ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=209715200

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Real Gmail SMTP Configuration ---
# Generate a 16-character Google App Password (requires Google 2-Step Verification)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password
MAIL_FROM=your_gmail_address@gmail.com

# --- Session Lifetime (seconds) ---
SESSION_EXPIRY=3600

