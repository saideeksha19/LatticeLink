# LatticeLink Backend Environment Variables
# Copy this file to .env in latticelink/backend/ (DO NOT commit .env to version control)

# --- Flask Server Security ---
SECRET_KEY=latticelink-quantum-dev-secret-key-change-in-prod
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# --- Database Configuration ---
DATABASE_URL=sqlite:///instance/latticelink.db

# --- Storage Directory for Encrypted Files & Media ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=209715200

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Email Delivery via Resend HTTP API (free tier: 100 emails/day, 3000/month) ---
# 1. Create a free Resend account at https://resend.com (no credit card).
# 2. Add and verify your sending domain: Resend Dashboard -> Domains
#    (add the DNS records Resend shows; sandbox 'onboarding@resend.dev' can
#    only deliver to your own account email).
# 3. Create an API key: Resend Dashboard -> API Keys.
# 4. Put the REAL values ONLY in the Render Dashboard -> Environment.
#    NEVER commit real credentials to version control.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=LatticeLink <noreply@yourdomain.com>

# --- Session Lifetime (seconds) ---
SESSION_EXPIRY=3600

