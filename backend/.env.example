# LatticeLink Backend Environment Variables
# Copy this file to .env in latticelink/backend/ (DO NOT commit .env to version control)

# --- Flask Server Security ---
SECRET_KEY=latticelink-quantum-dev-secret-key-change-in-prod
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# --- Database Configuration ---
DATABASE_URL=sqlite:///instance/latticelink.db

# --- Storage Directory for Encrypted Files & Media ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=209715200

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Email Delivery via Resend (https://resend.com) ---
# RESEND_API_KEY: create one at https://resend.com/api-keys
# NEVER commit the real key. Set it in the Render Dashboard -> Environment.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM: a sender identity verified in your Resend account.
# Use onboarding@resend.dev for sandbox testing, or a verified domain sender in production.
RESEND_FROM=LatticeLink <noreply@yourdomain.com>

# --- Session Lifetime (seconds) ---
SESSION_EXPIRY=3600

