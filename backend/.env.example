# LatticeLink Backend Environment Variables
# Copy this file to .env in latticelink/backend/ (DO NOT commit .env to version control)

# --- Flask Server Security ---
SECRET_KEY=latticelink-quantum-dev-secret-key-change-in-prod
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# --- Database Configuration ---
DATABASE_URL=sqlite:///instance/latticelink.db

# --- Storage Directory for Encrypted Files & Media ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=209715200

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Email Delivery via AgentMail REST API (free @agentmail.to inbox) ---
# 1. Create a free AgentMail account at https://agentmail.to (no credit card;
#    no custom domain required - default @agentmail.to inboxes work).
# 2. IMPORTANT: complete the one-time AgentMail ACCOUNT verification in the
#    console (OTP to the account owner's own email). This is the account
#    owner's verification, NOT any LatticeLink user's credential. It unlocks
#    sending to external recipients (gmail.com, yahoo.com, ...).
# 3. Create one inbox on the free @agentmail.to domain and copy its inbox ID.
# 4. Create a server API key: AgentMail Console -> API Keys.
# 5. Put the REAL values ONLY in the Render Dashboard -> Environment.
#    NEVER commit real credentials to version control.
AGENTMAIL_API_KEY=am_your_agentmail_api_key_here
AGENTMAIL_INBOX_ID=your_agentmail_inbox_id_here

# --- Session Lifetime (seconds) ---
SESSION_EXPIRY=3600

