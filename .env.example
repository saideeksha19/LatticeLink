# =====================================================================
# LatticeLink — Environment Configuration Template
# =====================================================================
# Copy this file to .env in latticelink/backend/ or latticelink/ root:
# DO NOT commit .env with real credentials into git!

# --- Email Delivery via AgentMail REST API (Free @agentmail.to inbox) ---
# 1. Create a free AgentMail account at https://agentmail.to (no credit card required).
# 2. Complete the one-time AgentMail account verification in the console.
# 3. Create one inbox on the free @agentmail.to domain and copy its inbox ID.
# 4. Generate a server API key in the AgentMail Console.
# 5. Set these variables in .env (or Render Dashboard -> Environment):
AGENTMAIL_API_KEY=am_your_agentmail_api_key_here
AGENTMAIL_INBOX_ID=your_agentmail_inbox_id_here

# In local development without AgentMail keys, mock mode automatically logs 
# OTP codes to the backend console/terminal for testing.
DEV_MOCK_EMAIL=true

# --- Application & PQC Security ---
SECRET_KEY=latticelink-quantum-resistant-production-secret-key-128
HOST=0.0.0.0
PORT=5000
DEBUG=False
SESSION_EXPIRY=3600
FRONTEND_URL=http://localhost:5173

# --- Backend URL for Socket.IO (Vercel frontend -> Render backend) ---
# Vite exposes VITE_* variables to the frontend bundle. No secrets here.
VITE_BACKEND_URL=https://latticelink-backend.onrender.com

# --- WebRTC TURN Configuration ---
VITE_TURN_URL=stun:stun.l.google.com:19302

# Note: SMS verification has been disabled. Email OTP is the sole verification method.

